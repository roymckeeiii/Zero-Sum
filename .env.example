# Zero Sum configuration. Environment only: nothing personal is hard-coded in the app.
# Values must not carry trailing comments (env-file parsers keep them as part of the value).

# --- required
# Postgres role created by `python app.py init-db` (grants.sql)
DATABASE_URL=postgresql://iz_unified:CHANGE_ME@db:5432/inboxzero
# Same values as Inbox Zero's: they decrypt the Google tokens it stores
EMAIL_ENCRYPT_SECRET=
EMAIL_ENCRYPT_SALT=
# Same Google OAuth client as Inbox Zero: used to refresh access tokens
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only for `python app.py init-db`: Inbox Zero's database owner (in compose: postgresql://postgres:<pw>@db:5432/inboxzero)
ADMIN_DATABASE_URL=
# Comma-separated addresses allowed in; compared with the header below
ALLOWED_EMAILS=you@example.com

# --- optional
# Header your authenticating proxy sets (Cloudflare Access default; oauth2-proxy uses X-Forwarded-Email)
AUTH_EMAIL_HEADER=Cf-Access-Authenticated-User-Email
# Linked account whose Inbox Zero rules are copied to the others; leave empty to turn rule sync off
MASTER_EMAIL=you@example.com
# Your Inbox Zero address, for the "Inbox Zero" and "Edit rules" links
INBOX_ZERO_URL=https://inbox-zero.example.com
PORT=8080
COLLECT_EVERY_MIN=15
RULES_EVERY_MIN=10
BACKFILL_DAYS=180
BACKFILL_STEP=400
# Gmail quota units per second per account (Google allows 250; Inbox Zero shares the same quota)
GMAIL_UNITS_PER_SEC=50
# Gmail label for held mail (Quarantine tab)
QUARANTINE_LABEL=Quarantine
