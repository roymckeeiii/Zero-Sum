# Zero Sum configuration. Environment only: nothing personal is hard-coded in the app.
# Values must not carry trailing comments (env-file parsers keep them as part of the value).

# --- required
# Postgres role created by `python app.py init-db` (grants.sql)
DATABASE_URL=postgresql://iz_unified:CHANGE_ME@db:5432/inboxzero
# Same values as Inbox Zero's: they decrypt the Google tokens it stores
EMAIL_ENCRYPT_SECRET=
EMAIL_ENCRYPT_SALT=
# Same Google OAuth client as Inbox Zero: used to refresh access tokens
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only for `python app.py init-db`: Inbox Zero's database owner (in compose: postgresql://postgres:<pw>@db:5432/inboxzero)
ADMIN_DATABASE_URL=
# Comma-separated addresses allowed in
ALLOWED_EMAILS=you@example.com
# Sign-in. Behind Cloudflare Access set both: the team domain (<team>.cloudflareaccess.com) and the Access
# application's AUD tag. The signed Cf-Access-Jwt-Assertion token then says who is signed in.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Without the two above the app refuses to start, unless this is 1. Local development only: the app then believes
# the plain e-mail header below, which anything that can reach its port can send.
ALLOW_HEADER_TRUST=

# --- optional
# Whose mailboxes Zero Sum may use, when the Inbox Zero instance has more than one user: comma-separated Inbox Zero
# user ids and/or login e-mails. Empty = every Google mailbox linked in the Inbox Zero database.
ACCOUNT_OWNERS=
# Only read with ALLOW_HEADER_TRUST=1: the header your proxy sets (oauth2-proxy uses X-Forwarded-Email)
AUTH_EMAIL_HEADER=Cf-Access-Authenticated-User-Email
# Address the server listens on. Default 127.0.0.1; the container image sets 0.0.0.0 (the published port decides).
# LISTEN_HOST=127.0.0.1
# Linked account whose Inbox Zero rules are copied to the others; leave empty to turn rule sync off
MASTER_EMAIL=you@example.com
# Your Inbox Zero address, for the "Inbox Zero" and "Edit rules" links
INBOX_ZERO_URL=https://inbox-zero.example.com
PORT=8080
COLLECT_EVERY_MIN=15
RULES_EVERY_MIN=10
# Most rule copies the automatic rule sync deletes in one run; more wait for "Sync now" in the Rules tab
RULES_AUTO_MAX_DELETES=3
BACKFILL_DAYS=0
BACKFILL_STEP=2000
# Gmail quota units per second per account (Google allows 250; Inbox Zero shares the same quota)
GMAIL_UNITS_PER_SEC=50
# Gmail label for held mail (Quarantine tab)
QUARANTINE_LABEL=Quarantine
# Most emails one bulk action touches per account
MAX_BULK=200000
# Most emails the confirmation dialog counts per account before it says "or more"
PREVIEW_MAX=20000
# Most senders one confirmation dialog reads from Gmail for mail not collected yet; the rest is shown as "up to"
PREVIEW_LOOKUPS=100
# AI suggest (OpenAI-compatible API; OpenRouter by default). Leave the key empty to hide the button.
OPENROUTER_API_KEY=
AI_MODEL=anthropic/claude-haiku-5.5
# Background analyst: AI calls per day (all AI features), senders planned per 15-min run, minimum emails per sender
AI_MAX_CALLS_PER_DAY=400
AI_PLANS_PER_RUN=4
AI_MIN_EMAILS=5
# AI sort: tries after the AI provider or Gmail was busy (15, 30, 45... minutes apart) before a pass is given up
AI_SORT_RETRIES=5
